<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Data</title>
  <style>
    :root {
      --bg-primary: #030712;
      --bg-secondary: rgba(15, 23, 42, 0.95);
      --bg-tertiary: #020617;

      --text-primary: #e5e7eb;
      --text-secondary: #9ca3af;
      --text-tertiary: #6b7280;

      --neural-cyan: #22d3ee;
      --neural-purple: #7c3aed;
      --neural-pink: #ec4899;

      --border-color: rgba(148, 163, 184, 0.45);
      --transition-speed: 0.35s;
    }

    @keyframes bgShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      height: 100%;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
    }

    body {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 1.5rem;
      background:
        radial-gradient(circle at 0% 0%, #1d4ed8 0, transparent 55%),
        radial-gradient(circle at 100% 100%, #7c3aed 0, transparent 55%),
        linear-gradient(135deg, #020617 0%, #0b1120 50%, #020617 100%);
      background-size: 200% 200%;
      animation: bgShift 18s ease-in-out infinite;
      position: relative;
      overflow-x: hidden;
    }

    /* Grid overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: url('data:image/svg+xml,<svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="grid" width="80" height="80" patternUnits="userSpaceOnUse"><path d="M 80 0 L 0 0 0 80" fill="none" stroke="rgba(148,163,184,0.18)" stroke-width="0.5"/></pattern></defs><rect width="100%" height="100%" fill="url(%23grid)"/></svg>');
      opacity: 0.5;
      pointer-events: none;
      z-index: 0;
    }

    /* Corner triangles background */
    .background-container {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .triangle-group-1,
    .triangle-group-2 {
      position: absolute;
      width: 460px;
      height: 460px;
      transform-origin: center center;
      will-change: transform;
      opacity: 0.95;
    }

    /* bottom-left red/yellow */
    .triangle-group-1 {
      bottom: 0;
      left: 0;
      transform: translate(-40%, 40%) rotate(325.932deg);
    }

    /* top-right red/purple/blue */
    .triangle-group-2 {
      top: 0;
      right: 0;
      transform: translate(40%, -40%) rotate(251.777deg);
    }

    .container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 1100px;
    }

    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.4rem;
      margin-bottom: 1.5rem;
      border-radius: 16px;
      background: linear-gradient(
        145deg,
        rgba(15, 23, 42, 0.96),
        rgba(15, 23, 42, 0.85)
      );
      border: 1px solid var(--border-color);
      box-shadow:
        0 12px 40px rgba(15, 23, 42, 0.95),
        0 0 30px rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .navbar h1 {
      font-size: 1.3rem;
      font-weight: 700;
      background: linear-gradient(135deg,
        var(--neural-cyan),
        #3b82f6,
        var(--neural-purple));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .user-info a {
      color: #fecaca;
      text-decoration: none;
      font-size: 0.9rem;
    }

    .logout-btn {
      padding: 0.45rem 0.9rem;
      border-radius: 9999px;
      border: 1px solid rgba(248, 113, 113, 0.8);
      background: rgba(127, 29, 29, 0.8);
      font-weight: 500;
      transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
      box-shadow: 0 2px 10px rgba(248, 113, 113, 0.5);
    }

    .logout-btn:hover {
      background: rgba(220, 38, 38, 0.95);
      box-shadow: 0 4px 16px rgba(248, 113, 113, 0.7);
      transform: translateY(-1px);
    }

    .card {
      background: linear-gradient(
        145deg,
        rgba(15, 23, 42, 0.96),
        rgba(15, 23, 42, 0.85)
      );
      box-shadow:
        0 18px 60px rgba(15, 23, 42, 0.95),
        0 0 40px rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-radius: 18px;
      border: 1px solid var(--border-color);
      padding: 2rem 1.8rem;
      transition: transform var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease,
                  border-color var(--transition-speed) ease;
    }

    .card:hover {
      transform: translateY(-6px);
      border-color: rgba(148, 163, 184, 0.85);
      box-shadow:
        0 24px 80px rgba(15, 23, 42, 1),
        0 0 60px rgba(56, 189, 248, 0.35);
    }

    .card h2 {
      font-size: 1.6rem;
      margin-bottom: 1rem;
      font-weight: 700;
      background: linear-gradient(135deg,
        var(--neural-cyan),
        #3b82f6,
        var(--neural-purple),
        var(--neural-pink));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 0.5px;
    }

    .alert {
      margin-bottom: 1rem;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(248, 113, 113, 0.5);
      color: #fecaca;
      font-size: 0.95rem;
      box-shadow: 0 0 18px rgba(248, 113, 113, 0.25);
    }

    .entries {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.2rem;
      margin-top: 1rem;
    }

    .entry-card {
      background: rgba(15, 23, 42, 0.9);
      border-radius: 14px;
      border: 1px solid rgba(148, 163, 184, 0.45);
      padding: 1rem 1.1rem;
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.9);
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
      font-size: 0.93rem;
    }

    .entry-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 26px rgba(15, 23, 42, 1);
      border-color: rgba(56, 189, 248, 0.8);
    }

    .entry-card h3 {
      margin: 0 0 0.5rem 0;
      font-size: 1.05rem;
      color: #e5e7eb;
    }

    .entry-card p {
      margin: 0.15rem 0;
      color: #cbd5f5;
    }

    .entry-card button {
      margin-top: 0.25rem;
      margin-bottom: 0.4rem;
      padding: 0.35rem 0.7rem;
      border-radius: 9999px;
      border: none;
      background: linear-gradient(135deg, var(--neural-cyan), var(--neural-purple));
      color: #fff;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 2px 10px rgba(34, 211, 238, 0.45);
      transition: all 0.25s ease;
      position: relative;
      overflow: hidden;
    }

    .entry-card button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
      transition: left 0.25s ease;
    }

    .entry-card button:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(56, 189, 248, 0.8);
    }

    .entry-card button:hover::before {
      left: 100%;
    }

    .entry-card small {
      display: block;
      margin-top: 0.4rem;
      color: #9ca3af;
      font-size: 0.78rem;
    }

    .empty-state {
      text-align: center;
      margin-top: 2.5rem;
    }

    .empty-state p {
      font-size: 1rem;
      color: #9ca3af;
      margin-bottom: 0.9rem;
    }

    .btn {
      display: inline-block;
      padding: 0.8rem 1.4rem;
      border-radius: 9999px;
      background: linear-gradient(135deg,
        var(--neural-cyan),
        #3b82f6,
        var(--neural-purple));
      color: #ffffff;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.96rem;
      letter-spacing: 0.04em;
      box-shadow:
        0 10px 30px rgba(59,130,246,0.45),
        0 0 25px rgba(59,130,246,0.6);
      border: none;
      position: relative;
      overflow: hidden;
      transition: transform var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease;
    }

    .btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg,
        transparent,
        rgba(255,255,255,0.32),
        transparent);
      transform: translateX(-100%);
      transition: transform var(--transition-speed) ease;
    }

    .btn:hover {
      transform: translateY(-3px);
      box-shadow:
        0 18px 40px rgba(59,130,246,0.6),
        0 0 35px rgba(236,72,153,0.7);
    }

    .btn:hover::before {
      transform: translateX(100%);
    }

    h3 {
      margin-top: 2rem;
      margin-bottom: 0.6rem;
      font-size: 1.1rem;
      color: var(--text-primary);
    }

    ul {
      list-style-type: none;
      padding: 0;
      margin-bottom: 1rem;
    }

    ul li {
      margin: 0.3rem 0;
    }

    ul li a {
      text-decoration: none;
      color: #38bdf8;
      font-size: 0.95rem;
    }

    ul li a:hover {
      text-decoration: underline;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 0.8rem;
      font-size: 0.9rem;
      background: rgba(15, 23, 42, 0.96);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 8px 22px rgba(15, 23, 42, 1);
    }

    th,
    td {
      padding: 0.6rem 0.75rem;
      text-align: left;
      border-bottom: 1px solid rgba(55, 65, 81, 0.9);
    }

    th {
      background: rgba(15, 23, 42, 0.98);
      color: #e5e7eb;
      font-weight: 600;
    }

    tr:nth-child(even) td {
      background: rgba(17, 24, 39, 0.96);
    }

    td {
      color: #d1d5db;
    }

    td a {
      color: #38bdf8;
      text-decoration: none;
    }

    td a:hover {
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      body {
        padding: 1rem;
      }
      .navbar {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.4rem;
      }
      table {
        font-size: 0.8rem;
      }
    }

    /* CampusHelp shared journey frame: additive styles, keeping each page's original content intact. */
    .campus-frame-header { position: sticky; top: 10px; z-index: 5; width: min(1180px, calc(100% - 40px)); min-height: 68px; margin: 0 auto; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border: 1px solid rgba(255,255,255,.18); border-radius: 0 0 18px 18px; background: rgba(9, 17, 35, .82); color: #f8fafc; box-shadow: 0 12px 32px rgba(2,6,23,.15); backdrop-filter: blur(14px); }
    .campus-wordmark { display: inline-flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; font-weight: 750; letter-spacing: .01em; white-space: nowrap; }
    .campus-mark { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 11px; background: linear-gradient(145deg,#73d6c5,#9c8df2); color: #101a35; font-weight: 850; }
    .campus-frame-header nav { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 10px 20px; }
    .campus-frame-header nav a { color: #e0e7ff; text-decoration: none; font-size: .88rem; font-weight: 600; }
    .campus-frame-header nav a:hover { color: #83e0d1; }
    .campus-frame-header nav .campus-next { padding: 9px 14px; border-radius: 999px; background: #a7f0df; color: #10243a; }
    .campus-flow-label { color: #bdc9df; font-size: .78rem; letter-spacing: .03em; }
    .campus-frame-footer { position: relative; z-index: 2; width: min(1180px, calc(100% - 40px)); margin: 28px auto 14px; padding: 12px 18px; display: flex; justify-content: space-between; gap: 12px; color: #cbd5e1; font-size: .76rem; letter-spacing: .07em; text-transform: uppercase; }
    @media (max-width: 620px) { .campus-frame-header { width: calc(100% - 20px); padding: 11px 13px; align-items: flex-start; } .campus-frame-header nav { gap: 8px 12px; } .campus-frame-header nav a { font-size: .78rem; } .campus-flow-label { width: 100%; text-align: right; } .campus-frame-footer { width: calc(100% - 28px); flex-wrap: wrap; } }
    .campus-frame-header + .background-container { z-index: 0; }
    body { display: block; min-height: 100vh; height: auto; padding: 0 24px 24px; overflow-x: hidden; background: radial-gradient(ellipse at 12% 8%, #17355d 0, transparent 42%), radial-gradient(ellipse at 88% 12%, #34456f 0, transparent 46%), #111d33; background-size: auto; animation: none; }
    body::before { opacity: .16; }
    .background-container { opacity: .22; }
    .container { width: min(1240px, 100%); max-width: none; margin: 28px auto 0; }
    .navbar { border-color: rgba(175,198,226,.24); box-shadow: 0 16px 42px rgba(2,8,24,.3); }
    .card { border-color: rgba(175,198,226,.24); box-shadow: 0 22px 58px rgba(2,8,24,.3); }
    .card:hover { transform: translateY(-2px); box-shadow: 0 26px 64px rgba(2,8,24,.36); }
    .entry-card { background: linear-gradient(145deg,rgba(24,43,70,.98),rgba(19,35,59,.96)); border-color: rgba(169,195,220,.2); box-shadow: 0 12px 28px rgba(2,8,24,.22); }
    .entry-card:hover { box-shadow: 0 16px 34px rgba(2,8,24,.3); }
    .campus-frame-footer { width: min(1180px, 100%); }
    @media (max-width: 640px) { body { padding: 0 12px 20px; } .container { margin-top: 18px; } }

    /* Dreamy CampusHelp palette inspired by the supplied skyline and room references. */
    :root { --bg-primary:#f8f5f3; --bg-secondary:rgba(255,255,255,.9); --bg-tertiary:#fffaf5; --text-primary:#273953; --text-secondary:#64738a; --text-tertiary:#7b8797; --neural-cyan:#59bdbb; --neural-purple:#8494e8; --neural-pink:#ee94a9; --neural-blue:#648ce2; --border-color:rgba(80,111,146,.2); }
    body { background:radial-gradient(ellipse at 12% 0%,#fff0dc 0,transparent 40%),radial-gradient(ellipse at 92% 14%,#e8e5ff 0,transparent 43%),linear-gradient(145deg,#f8f4ed,#fff7f3 48%,#f1f4fc); color:#293b55; }
    body::before { opacity:0; background-image:none; }
    .background-container { display:none !important; }
    .campus-frame-header { background:rgba(255,252,248,.88); color:#293b55; border-color:rgba(80,111,146,.18); box-shadow:0 12px 32px rgba(74,86,120,.1); }
    .campus-mark { background:linear-gradient(145deg,#a9e3d5,#c3c3f3); color:#293b55; }
    .campus-frame-header nav a { color:#405675; }
    .campus-frame-header nav .campus-next { background:linear-gradient(110deg,#a9e3d5,#c8d5ff); color:#273953; }
    .campus-flow-label { color:#75839a; }
    .campus-frame-footer { color:#78849a; border-color:rgba(80,111,146,.18); }
    input, textarea, select { accent-color:#6dbeb7; }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior:auto !important; animation-duration:.01ms !important; transition-duration:.01ms !important; } }

    body { background:radial-gradient(ellipse at 14% 0%,#ffead7 0,transparent 40%),radial-gradient(ellipse at 91% 13%,#e5e3ff 0,transparent 44%),linear-gradient(145deg,#f6f3ed,#fff8f4 52%,#f0f4fc); color:#293b55; }
    .navbar { background:rgba(255,252,248,.9); border-color:rgba(79,112,149,.18); box-shadow:0 12px 34px rgba(62,86,125,.1); }
    .navbar h1 { background:linear-gradient(110deg,#467bad,#7b83c7); -webkit-background-clip:text; background-clip:text; }
    .navbar .user-info { color:#64748a; }
    .navbar .user-info a, .navbar .logout-btn { background:#fff1ed; color:#a95e64; border:1px solid rgba(195,116,119,.3); box-shadow:none; }
    .card { background:rgba(255,253,250,.94); border-color:rgba(79,112,149,.18); box-shadow:0 20px 54px rgba(62,86,125,.12); }
    .card:hover { box-shadow:0 23px 58px rgba(62,86,125,.14); }
    .card h2 { background:linear-gradient(110deg,#4b86b7,#7d83c8 60%,#bb849f); -webkit-background-clip:text; background-clip:text; }
    .entry-card { background:linear-gradient(145deg,#fffdf9,#f8f7ff); border-color:rgba(79,112,149,.18); box-shadow:0 10px 28px rgba(62,86,125,.1); }
    .entry-card h3 { color:#344a64; }
    .entry-card p { color:#62748a; }
    .entry-card small { color:#8793a3; }
    .entry-card button, .btn { background:linear-gradient(110deg,#73c9bd,#8294e8); box-shadow:0 7px 20px rgba(112,151,200,.18); }
    .empty-state p { color:#687a90; }
    .alert { color:#9b5258; background:#fff0ed; border-color:#f0c8c3; box-shadow:none; }
    th { background:#e9ecf8; color:#344a64; }
    tr:nth-child(even) td { background:#f4f5fa; }
    td { color:#536982; border-color:rgba(79,112,149,.16); }
    td a { color:#527fba; }

  </style>
</head>
<body>
  <header class="campus-frame-header"><a class="campus-wordmark" href="/login" aria-label="CampusHelp home"><span class="campus-mark">C</span><span>CampusHelp</span></a><nav aria-label="Workspace navigation"><span class="campus-flow-label">Step 3 of 3 · Student workspace</span><a href="/data">Edit profile</a></nav></header>
  <!-- Corner background triangles -->
  <div class="background-container">
    <div class="triangle-group-1" id="triangle1">
      <svg width="100%" height="100%" viewBox="0 0 388 387" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g>
          <path
            d="M116.13 125.931C113.934 106.917 133.046 92.5888 150.681 100.028L291.135 159.272C308.916 166.772 311.855 190.733 296.416 202.309L173.456 294.495C158.016 306.071 135.839 296.532 133.624 277.362L116.13 125.931Z"
            fill="url(#gradient1)"/>
          <path
            d="M141.702 155.147C139.265 135.955 158.615 121.386 176.385 129.033L248.166 159.923C265.797 167.51 268.655 191.313 253.321 202.859L191.385 249.492C176.051 261.037 153.965 251.711 151.547 232.669L141.702 155.147Z"
            fill="black"/>
        </g>
        <defs>
          <linearGradient id="gradient1" x1="304.91" y1="110.015" x2="82.4806" y2="276.775" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#FF0D0D"/>
            <stop offset="1" stop-color="#E7D000"/>
          </linearGradient>
        </defs>
      </svg>
    </div>

    <div class="triangle-group-2" id="triangle2">
      <svg width="100%" height="100%" viewBox="0 0 388 387" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g>
          <path
            d="M116.13 125.931C113.934 106.917 133.046 92.5888 150.681 100.028L291.135 159.272C308.916 166.772 311.855 190.733 296.416 202.309L173.456 294.495C158.016 306.071 135.839 296.532 133.624 277.362L116.13 125.931Z"
            fill="url(#gradient2)"/>
          <path
            d="M141.702 155.147C139.265 135.955 158.615 121.386 176.385 129.033L248.166 159.923C265.797 167.51 268.655 191.313 253.321 202.859L191.385 249.492C176.051 261.037 153.965 251.711 151.547 232.669L141.702 155.147Z"
            fill="black"/>
        </g>
        <defs>
          <linearGradient id="gradient2" x1="304.91" y1="110.015" x2="82.4806" y2="276.775" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#FF0D0D"/>
            <stop offset="0.576923" stop-color="#2915A5"/>
            <stop offset="1" stop-color="#000DC8"/>
          </linearGradient>
        </defs>
      </svg>
    </div>
  </div>

  <div class="container">
    <nav class="navbar">
      <h1>Welcome, {{user.name}}</h1>
      <div class="user-info">
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </nav>

    <div class="card">
      {{#if error}}
        <div class="alert">{{error}}</div>
      {{/if}}

      <h2>Your Stored Information</h2>

      {{#if dataEntries}}
        <div class="entries">
          {{#each dataEntries}}
            <div class="entry-card">
              <h3>{{this.name}}</h3>
              <button onclick="copyDataAsLinesName('{{this.name}}')">Copy Name</button>

              <p>Mobile: {{this.mobileNumber}}</p>
              <button onclick="copyDataAsLinesMobile('{{this.mobileNumber}}')">Copy Mobile</button>

              <p>Address: {{this.address}}</p>
              <button onclick="copyDataAsLinesAdd('{{this.address}}')">Copy Address</button>

              <p>Education: {{this.boardOfEducation}}</p>
              <button onclick="copyDataAsLinesED('{{this.boardOfEducation}}')">Copy Education</button>

              <p>Aadhar Number: {{this.adharNumber}}</p>
              <button onclick="copyDataAsLinesAdhar('{{this.adharNumber}}')">Copy Aadhar</button>

              <small>Created: {{this.createdAt}}</small>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="empty-state">
          <p>No entries found.</p>
          <a href="/data" class="btn">Add Your First Entry</a>
        </div>
      {{/if}}
    </div>

    <h3>Open in Split Screen:</h3>
    <ul>
      <li><a href="#" onclick="return openSplitScreen('https://www.example.com')">Example.com</a></li>
      <li><a href="#" onclick="return openSplitScreen('https://www.wikipedia.org')">Wikipedia</a></li>
      <li><a href="#" onclick="return openSplitScreen('https://www.google.com')">Google</a></li>
    </ul>

    <table>
      <tr>
        <th>College Name</th>
        <th colspan="2">Admission Process</th>
