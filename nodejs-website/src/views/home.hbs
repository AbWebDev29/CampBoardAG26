<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>
  <style>
    :root {
      --bg-primary: #030712;
      --bg-secondary: rgba(15, 23, 42, 0.95);
      --bg-tertiary: #020617;

      --text-primary: #e5e7eb;
      --text-secondary: #9ca3af;
      --text-tertiary: #6b7280;

      --neural-cyan: #22d3ee;
      --neural-purple: #7c3aed;
      --neural-pink: #ec4899;

      --border-color: rgba(148, 163, 184, 0.45);
      --transition-speed: 0.35s;
    }

    @keyframes bgShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      height: 100%;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
    }

    body {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 1.5rem;
      background:
        radial-gradient(circle at 0% 0%, #1d4ed8 0, transparent 55%),
        radial-gradient(circle at 100% 100%, #7c3aed 0, transparent 55%),
        linear-gradient(135deg, #020617 0%, #0b1120 50%, #020617 100%);
      background-size: 200% 200%;
      animation: bgShift 18s ease-in-out infinite;
      position: relative;
      overflow-x: hidden;
    }

    /* Grid overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: url('data:image/svg+xml,<svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="grid" width="80" height="80" patternUnits="userSpaceOnUse"><path d="M 80 0 L 0 0 0 80" fill="none" stroke="rgba(148,163,184,0.18)" stroke-width="0.5"/></pattern></defs><rect width="100%" height="100%" fill="url(%23grid)"/></svg>');
      opacity: 0.5;
      pointer-events: none;
      z-index: 0;
    }

    /* Corner triangles background */
    .background-container {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .triangle-group-1,
    .triangle-group-2 {
      position: absolute;
      width: 460px;
      height: 460px;
      transform-origin: center center;
      will-change: transform;
      opacity: 0.95;
    }

    /* bottom-left red/yellow */
    .triangle-group-1 {
      bottom: 0;
      left: 0;
      transform: translate(-40%, 40%) rotate(325.932deg);
    }

    /* top-right red/purple/blue */
    .triangle-group-2 {
      top: 0;
      right: 0;
      transform: translate(40%, -40%) rotate(251.777deg);
    }

    .container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 960px;
    }

    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.1rem 1.4rem;
      margin-bottom: 1.5rem;
      border-radius: 16px;
      background: linear-gradient(
        145deg,
        rgba(15, 23, 42, 0.96),
        rgba(15, 23, 42, 0.85)
      );
      border: 1px solid var(--border-color);
      box-shadow:
        0 12px 40px rgba(15, 23, 42, 0.95),
        0 0 30px rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .navbar h1 {
      font-size: 1.4rem;
      font-weight: 700;
      background: linear-gradient(135deg,
        var(--neural-cyan),
        #3b82f6,
        var(--neural-purple));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.95rem;
      color: var(--text-secondary);
    }

    .logout-btn {
      padding: 0.45rem 0.9rem;
      border-radius: 9999px;
      border: 1px solid rgba(248, 113, 113, 0.8);
      background: rgba(127, 29, 29, 0.8);
      color: #fecaca;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
      box-shadow: 0 2px 10px rgba(248, 113, 113, 0.4);
    }

    .logout-btn:hover {
      background: rgba(220, 38, 38, 0.95);
      box-shadow: 0 4px 16px rgba(248, 113, 113, 0.7);
      transform: translateY(-1px);
    }

    .card {
      background: linear-gradient(
        145deg,
        rgba(15, 23, 42, 0.96),
        rgba(15, 23, 42, 0.85)
      );
      border-radius: 18px;
      border: 1px solid var(--border-color);
      padding: 2.1rem 2rem;
      box-shadow:
        0 18px 60px rgba(15, 23, 42, 0.95),
        0 0 40px rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      transition: transform var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease,
                  border-color var(--transition-speed) ease;
    }

    .card:hover {
      transform: translateY(-6px);
      border-color: rgba(148, 163, 184, 0.85);
      box-shadow:
        0 24px 80px rgba(15, 23, 42, 1),
        0 0 60px rgba(56, 189, 248, 0.35);
    }

    .card h2 {
      font-size: 1.7rem;
      margin-bottom: 0.9rem;
      font-weight: 700;
      background: linear-gradient(135deg,
        var(--neural-cyan),
        #3b82f6,
        var(--neural-purple),
        var(--neural-pink));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 0.5px;
    }

    .card p {
      margin-bottom: 0.6rem;
      color: var(--text-secondary);
      line-height: 1.6;
      font-size: 1rem;
    }

    .btn {
      display: inline-block;
      margin-top: 1.2rem;
      padding: 0.85rem 1.5rem;
      border-radius: 9999px;
      background: linear-gradient(135deg,
        var(--neural-cyan),
        #3b82f6,
        var(--neural-purple));
      color: #ffffff;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.96rem;
      letter-spacing: 0.04em;
      border: none;
      box-shadow:
        0 10px 30px rgba(59,130,246,0.45),
        0 0 25px rgba(59,130,246,0.6);
      position: relative;
      overflow: hidden;
      transition: transform var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease;
    }

    .btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg,
        transparent,
        rgba(255,255,255,0.32),
        transparent);
      transform: translateX(-100%);
      transition: transform var(--transition-speed) ease;
    }

    .btn:hover {
      transform: translateY(-3px);
      box-shadow:
        0 18px 40px rgba(59,130,246,0.6),
        0 0 35px rgba(236,72,153,0.7);
    }

    .btn:hover::before {
      transform: translateX(100%);
    }

    .btn:active {
      transform: translateY(-1px);
    }

    @media (max-width: 640px) {
      body {
        padding: 1rem;
      }
      .navbar {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
      .card {
        padding: 1.8rem 1.5rem;
      }
    }

    /* Building-story homepage layout */
    body { display: block; min-height: 100vh; height: auto; padding: 28px 24px 56px; overflow-x: hidden; background: radial-gradient(ellipse at 15% 8%, #d9f0ec 0, transparent 38%), radial-gradient(ellipse at 90% 20%, #e3e8fb 0, transparent 40%), #edf2f5; color: #192d45; animation: none; }
    body::before { opacity: .18; }
    .background-container { opacity: .14; }
    .container { width: min(1180px, 100%); max-width: none; margin: 0 auto; }
    .navbar { position: sticky; top: 14px; z-index: 4; margin-bottom: 22px; background: rgba(15,31,55,.93); border-color: rgba(255,255,255,.14); box-shadow: 0 14px 40px rgba(30,51,78,.18); }
    .card { min-height: min(570px, 72vh); display:flex; flex-direction:column; align-items:flex-start; justify-content:center; padding: clamp(34px, 7vw, 88px); border-radius: 30px; background: linear-gradient(120deg,rgba(15,31,55,.97) 0 54%,rgba(20,41,70,.88)), repeating-linear-gradient(90deg,transparent 0 54px,rgba(176,222,231,.16) 55px 57px), repeating-linear-gradient(0deg,transparent 0 44px,rgba(176,222,231,.12) 45px 47px); box-shadow: 0 28px 75px rgba(30,51,78,.2); }
    .card h2 { font-size: clamp(2.3rem, 5vw, 4rem); }
    .card p { max-width: 540px; color: #d2deeb; }
    .building-storyboard { margin: clamp(52px, 9vw, 110px) 0 28px; display: grid; grid-template-columns: minmax(240px,.78fr) minmax(0,1.22fr); gap: clamp(24px,5vw,64px); align-items: stretch; }
    .building-story-copy { align-self:center; padding: clamp(25px,4vw,48px); border-radius: 26px; background: #f8f4ec; color: #243750; box-shadow: 0 22px 56px rgba(38,60,80,.12); }
    .building-story-copy .eyebrow { color:#638d8c; text-transform:uppercase; letter-spacing:.15em; font-size:.75rem; font-weight:800; }
    .building-story-copy h2 { margin:12px 0; font-size:clamp(1.7rem,3vw,2.7rem); color:#243750; }
    .building-story-copy p { color:#55677b; line-height:1.7; }
    .building-story-copy a { color:#247d7a; font-weight:700; }
    .building-floor-stack { display:grid; grid-template-rows:repeat(3,minmax(130px,1fr)); overflow:hidden; border:1px solid rgba(37,72,94,.24); border-radius:26px; background:linear-gradient(145deg,#dceae8,#dce2f2); box-shadow:0 22px 56px rgba(38,60,80,.13); }
    .building-floor { position:relative; display:grid; grid-template-columns: minmax(120px,.7fr) 1fr; align-items:center; gap:20px; padding:24px clamp(20px,4vw,42px); border-bottom:1px solid rgba(37,72,94,.22); }
    .building-floor:last-child { border-bottom:0; }
    .building-floor::before { content:''; position:absolute; inset:14px auto 14px 16px; width:4px; border-radius:4px; background:#80c9bd; }
    .building-floor span { color:#638d8c; font-size:.72rem; text-transform:uppercase; letter-spacing:.16em; font-weight:800; }
    .building-floor h3 { margin-top:6px; color:#243750; font-size:1.2rem; }
    .building-room { min-height:76px; border:1px solid rgba(74,107,135,.32); border-radius:12px; background:repeating-linear-gradient(90deg,transparent 0 27%,rgba(87,130,152,.22) 28% 29%,transparent 30%),linear-gradient(0deg,transparent 48%,rgba(87,130,152,.24) 49% 51%,transparent 52%),linear-gradient(135deg,rgba(255,255,255,.65),rgba(169,211,202,.34)); box-shadow:inset 0 -8px rgba(71,103,128,.12); }
    .background-container { display:none !important; }
    body::before { opacity:0; background-image:none; }
    .navbar { background:rgba(255,252,248,.9); border-color:rgba(79,112,149,.18); box-shadow:0 12px 34px rgba(62,86,125,.1); }
    .navbar h1 { background:linear-gradient(110deg,#467bad,#7b83c7); -webkit-background-clip:text; background-clip:text; }
    .user-info { color:#64748a; }
    .logout-btn { background:#fff1ed; color:#a95e64; border-color:rgba(195,116,119,.3); box-shadow:none; }
    .card { background:linear-gradient(120deg,#fff4e4 0%,#ffe3dc 54%,#e4e8ff 100%); border-color:rgba(97,126,166,.2); box-shadow:0 26px 68px rgba(76,96,142,.14); }
    .card h2 { background:linear-gradient(110deg,#477eae,#777fc3 65%,#af7898); -webkit-background-clip:text; background-clip:text; }
    .card p { color:#586a80; }
    .card .btn { background:linear-gradient(110deg,#73c9bd,#8294e8); box-shadow:0 9px 24px rgba(112,151,200,.2); }
    @media(max-width:760px){ body{padding:16px 14px 42px;} .building-storyboard{grid-template-columns:1fr;} .card{min-height:500px;} .building-floor{grid-template-columns:1fr minmax(110px,.8fr);padding:20px 24px;} }
  </style>
</head>
<body>
  <!-- Corner background triangles -->
  <div class="background-container">
    <div class="triangle-group-1" id="triangle1">
      <svg width="100%" height="100%" viewBox="0 0 388 387" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g>
          <path
            d="M116.13 125.931C113.934 106.917 133.046 92.5888 150.681 100.028L291.135 159.272C308.916 166.772 311.855 190.733 296.416 202.309L173.456 294.495C158.016 306.071 135.839 296.532 133.624 277.362L116.13 125.931Z"
            fill="url(#gradient1)"/>
          <path
            d="M141.702 155.147C139.265 135.955 158.615 121.386 176.385 129.033L248.166 159.923C265.797 167.51 268.655 191.313 253.321 202.859L191.385 249.492C176.051 261.037 153.965 251.711 151.547 232.669L141.702 155.147Z"
            fill="black"/>
        </g>
        <defs>
          <linearGradient id="gradient1" x1="304.91" y1="110.015" x2="82.4806" y2="276.775" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#FF0D0D"/>
            <stop offset="1" stop-color="#E7D000"/>
          </linearGradient>
        </defs>
      </svg>
    </div>

    <div class="triangle-group-2" id="triangle2">
      <svg width="100%" height="100%" viewBox="0 0 388 387" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g>
          <path
            d="M116.13 125.931C113.934 106.917 133.046 92.5888 150.681 100.028L291.135 159.272C308.916 166.772 311.855 190.733 296.416 202.309L173.456 294.495C158.016 306.071 135.839 296.532 133.624 277.362L116.13 125.931Z"
            fill="url(#gradient2)"/>
          <path
            d="M141.702 155.147C139.265 135.955 158.615 121.386 176.385 129.033L248.166 159.923C265.797 167.51 268.655 191.313 253.321 202.859L191.385 249.492C176.051 261.037 153.965 251.711 151.547 232.669L141.702 155.147Z"
            fill="black"/>
        </g>
        <defs>
          <linearGradient id="gradient2" x1="304.91" y1="110.015" x2="82.4806" y2="276.775" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#FF0D0D"/>
            <stop offset="0.576923" stop-color="#2915A5"/>
            <stop offset="1" stop-color="#000DC8"/>
          </linearGradient>
        </defs>
      </svg>
    </div>
  </div>

  <div class="container">
    <nav class="navbar">
      <h1>Welcome to our website</h1>
      <div class="user-info">
        <span>Welcome, {{user.name}}</span>
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </nav>

    <div class="card">
      <h2>Dashboard</h2>
      <p>You've successfully logged in!</p>
      <p>This is your protected home page.</p>
      <a href="/data" class="btn">Go to Data Entry</a>
    </div>
    <section class="building-storyboard" aria-label="CampusHelp building story">
      <article class="building-story-copy" id="home-story-copy" aria-live="polite">
        <span class="eyebrow">Your next steps, made clearer</span>
        <h2 id="home-story-title">About the journey</h2>
        <p id="home-story-text">CampusHelp helps students and families navigate college choices, applications, and the move into campus life with practical guidance at each step.</p>
        <a id="home-story-link" href="/data">Continue to your student profile →</a>
      </article>
      <div class="building-floor-stack" aria-label="Three CampusHelp journey floors">
        <article class="building-floor" data-story-title="About the journey" data-story-text="CampusHelp helps students and families navigate college choices, applications, and the move into campus life with practical guidance at each step." data-story-href="/data"><div><span>Floor 01</span><h3>About</h3></div><div class="building-room" aria-hidden="true"></div></article>
        <article class="building-floor" data-story-title="Tools for every step" data-story-text="Explore college and course recommendations, application guidance, scholarship discovery, interview preparation, and secure document management." data-story-href="/data"><div><span>Floor 02</span><h3>Features</h3></div><div class="building-room" aria-hidden="true"></div></article>
        <article class="building-floor" data-story-title="Your student workspace" data-story-text="Keep your student details organized and move from profile setup into your personal workspace whenever you are ready." data-story-href="/extension"><div><span>Floor 03</span><h3>Contact &amp; next steps</h3></div><div class="building-room" aria-hidden="true"></div></article>
      </div>
    </section>
  </div>

  <script>

    // Skyline zoom and floor-to-story copy progression.
    const dashboardHero = document.querySelector('.container > .card');
    const storyFloors = Array.from(document.querySelectorAll('.building-floor'));
    const storyTitle = document.getElementById('home-story-title');
    const storyText = document.getElementById('home-story-text');
    const storyLink = document.getElementById('home-story-link');
    let buildingFramePending = false;
    function updateBuildingStory() {
      const progress = Math.max(0, Math.min(1, window.scrollY / Math.max(1, window.innerHeight * .85)));
      if (dashboardHero) { dashboardHero.style.transform = `scale(${1 + progress * 1.75})`; dashboardHero.style.opacity = String(1 - progress); dashboardHero.style.transformOrigin = '72% 54%'; }
      const center = window.innerHeight * .55;
      let activeFloor = storyFloors[0];
      storyFloors.forEach((floor) => { const rect = floor.getBoundingClientRect(); if (rect.top < center) activeFloor = floor; });
      if (activeFloor && storyTitle && storyText && storyLink) { storyTitle.textContent = activeFloor.dataset.storyTitle; storyText.textContent = activeFloor.dataset.storyText; storyLink.href = activeFloor.dataset.storyHref; }
      buildingFramePending = false;
    }
    window.addEventListener('scroll', () => { if (!buildingFramePending) { requestAnimationFrame(updateBuildingStory); buildingFramePending = true; } }, { passive: true });
    window.addEventListener('resize', updateBuildingStory);
    updateBuildingStory();

    // scroll‑driven triangle motion
    const triangle1 = document.getElementById('triangle1');
    const triangle2 = document.getElementById('triangle2');

    const initialRotation1 = 325.932;
    const initialRotation2 = 251.777;

    let ticking = false;

    function updateTriangles() {
      const scrollY = window.scrollY || window.pageYOffset;
      const windowHeight = window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;
      const maxScroll = documentHeight - windowHeight || 1;

      const scrollPercent = Math.min(1, Math.max(0, scrollY / maxScroll));

      const rotate1 = initialRotation1 + scrollPercent * 180;
      const translateX1 = scrollPercent * 60;
      const translateY1 = Math.sin(scrollPercent * Math.PI * 2) * 30;
      const scale1 = 1 + Math.sin(scrollPercent * Math.PI * 2) * 0.06;

      const rotate2 = initialRotation2 - scrollPercent * 180;
      const translateX2 = -scrollPercent * 60;
      const translateY2 = Math.cos(scrollPercent * Math.PI * 2) * 30;
      const scale2 = 1 + Math.cos(scrollPercent * Math.PI * 2) * 0.06;

      triangle1.style.transform = `
        translate(-40%, 40%)
        translate(${translateX1}px, ${translateY1}px)
        rotate(${rotate1}deg)
        scale(${scale1})
      `;

      triangle2.style.transform = `
        translate(40%, -40%)
        translate(${translateX2}px, ${translateY2}px)
        rotate(${rotate2}deg)
        scale(${scale2})
      `;

      ticking = false;
    }

    function requestTick() {
      if (!ticking) {
        window.requestAnimationFrame(updateTriangles);
        ticking = true;
      }
    }

    window.addEventListener('scroll', requestTick);
    window.addEventListener('resize', updateTriangles);
    updateTriangles();
  </script>
</body>
</html>
