<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Effortless College Journey</title>

  <style>
    :root {
      --bg-primary: #030712;
      --bg-secondary: rgba(15, 23, 42, 0.85);
      --bg-tertiary: #020617;

      --text-primary: #e5e7eb;
      --text-secondary: #9ca3af;

      --neural-cyan: #22d3ee;
      --neural-purple: #7c3aed;
      --neural-pink: #ec4899;
      --neural-blue: #3b82f6;

      --border-color: rgba(148, 163, 184, 0.4);
      --transition-speed: 0.35s;
    }

    @keyframes bgShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 20px rgba(34, 211, 238, 0.25); }
      50% {
        box-shadow:
          0 0 40px rgba(34, 211, 238, 0.5),
          0 0 30px rgba(124, 58, 237, 0.35);
      }
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      scroll-behavior: smooth;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
    }

    body {
      background:
        radial-gradient(circle at 0% 0%, #1d4ed8 0, transparent 55%),
        radial-gradient(circle at 100% 100%, #7c3aed 0, transparent 55%),
        linear-gradient(135deg, #020617 0%, #0b1120 50%, #020617 100%);
      background-size: 200% 200%;
      animation: bgShift 18s ease-in-out infinite;
      position: relative;
      overflow-x: hidden;
    }

    /* Grid overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: url('data:image/svg+xml,<svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="grid" width="80" height="80" patternUnits="userSpaceOnUse"><path d="M 80 0 L 0 0 0 80" fill="none" stroke="rgba(148,163,184,0.18)" stroke-width="0.5"/></pattern></defs><rect width="100%" height="100%" fill="url(%23grid)"/></svg>');
      pointer-events: none;
      opacity: 0.5;
      z-index: 0;
    }

    /* Corner triangles background */
    .background-container {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .triangle-group-1,
    .triangle-group-2 {
      position: absolute;
      width: 480px;
      height: 480px;
      transform-origin: center center;
      will-change: transform;
      opacity: 0.95;
    }

    /* bottom-left red/yellow */
    .triangle-group-1 {
      bottom: 0;
      left: 0;
      transform: translate(-40%, 40%) rotate(325.932deg);
    }

    /* top-right red/purple/blue */
    .triangle-group-2 {
      top: 0;
      right: 0;
      transform: translate(40%, -40%) rotate(251.777deg);
    }

    .wrapper {
      position: relative;
      min-height: 100vh;
      z-index: 1;
      padding-bottom: 4rem;
    }

    .content {
      position: relative;
      width: 100%;
      z-index: 1;
    }

    .section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 1rem;
    }

    /* Glass cards – simplified, higher contrast */
    .glass {
      max-width: 720px;
      width: 90%;
      margin: 2rem auto 0 auto;
      padding: 2.5rem 2rem;
      border-radius: 18px;
      background: linear-gradient(
        145deg,
        rgba(15, 23, 42, 0.9),
        rgba(15, 23, 42, 0.7)
      );
      border: 1px solid var(--border-color);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow:
        0 18px 60px rgba(15, 23, 42, 0.95),
        0 0 40px rgba(15, 23, 42, 0.9);
      transition: transform var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease,
                  border-color var(--transition-speed) ease;
      animation: pulseGlow 10s ease-in-out infinite;
      position: relative;
      overflow: hidden;
    }

    .glass:hover {
      transform: translateY(-6px);
      border-color: rgba(148, 163, 184, 0.8);
      box-shadow:
        0 25px 80px rgba(15, 23, 42, 1),
        0 0 60px rgba(56, 189, 248, 0.35);
    }

    .glass::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top left,
        rgba(56,189,248,0.18),
        transparent 55%);
      opacity: 0.7;
      pointer-events: none;
    }

    .glass > * {
      position: relative;
      z-index: 1;
    }

    h2 {
      font-size: 2.4rem;
      margin-bottom: 1.5rem;
      letter-spacing: -0.03em;
      font-weight: 700;
      background: linear-gradient(135deg,
        var(--neural-cyan),
        var(--neural-blue),
        var(--neural-purple),
        var(--neural-pink));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    p {
      font-size: 1.06rem;
      line-height: 1.8;
      color: var(--text-secondary);
    }

    ul.features-list {
      padding-left: 1.4rem;
      margin-top: 0.5rem;
    }

    ul.features-list li {
      margin-bottom: 0.8rem;
      color: var(--text-secondary);
      font-size: 1.02rem;
    }

    ul.features-list li::before {
      content: '•';
      color: var(--neural-cyan);
      margin-right: 0.45rem;
      font-size: 1.15rem;
    }

    .contact-form,
    .login-form {
      max-width: 420px;
      margin-top: 1.6rem;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.45rem;
      font-size: 0.9rem;
      color: var(--text-secondary);
    }

    .contact-form input,
    .contact-form textarea,
    .login-form input {
      width: 100%;
      padding: 0.85rem 1rem;
      border-radius: 10px;
      border: 1px solid var(--border-color);
      background: rgba(15, 23, 42, 0.85);
      color: var(--text-primary);
      font-size: 0.98rem;
      outline: none;
      transition: border-color var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease,
                  background var(--transition-speed) ease,
                  transform var(--transition-speed) ease;
      backdrop-filter: blur(10px);
    }

    .contact-form input::placeholder,
    .contact-form textarea::placeholder,
    .login-form input::placeholder {
      color: #6b7280;
    }

    .contact-form input:focus,
    .contact-form textarea:focus,
    .login-form input:focus {
      border-color: var(--neural-cyan);
      box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.5);
      transform: translateY(-1px);
      background: rgba(15, 23, 42, 0.95);
    }

    .contact-form textarea {
      resize: vertical;
      min-height: 100px;
    }

    .contact-form button,
    .login-form button[type="submit"] {
      width: 100%;
      padding: 0.95rem;
      border-radius: 999px;
      border: none;
      background: linear-gradient(135deg,
        var(--neural-cyan),
        var(--neural-blue),
        var(--neural-purple));
      color: #f9fafb;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      box-shadow:
        0 10px 30px rgba(59,130,246,0.45),
        0 0 25px rgba(59,130,246,0.6);
      transition: transform var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease;
    }

    .contact-form button:hover,
    .login-form button[type="submit"]:hover {
      transform: translateY(-3px);
      box-shadow:
        0 18px 40px rgba(59,130,246,0.6),
        0 0 35px rgba(236,72,153,0.7);
    }

    .contact-form button:active,
    .login-form button[type="submit"]:active {
      transform: translateY(-1px);
    }

    .login-form .form-footer {
      margin-top: 1.3rem;
      font-size: 0.9rem;
      color: var(--text-secondary);
      text-align: center;
    }

    .login-form .form-footer a {
      color: var(--neural-cyan);
      text-decoration: none;
      font-weight: 500;
    }

    .login-form .form-footer a:hover {
      text-decoration: underline;
    }

    /* FAB nav – keep as is, but no theme button */
    .fab {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      z-index: 3;
    }

    .btn {
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      border-radius: 999px;
      transition: transform var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease;
      color: #f9fafb;
    }

    .btn-circle {
      border-radius: 50%;
    }

    .btn-lg {
      width: 3.4rem;
      height: 3.4rem;
      font-size: 1.05rem;
    }

    .btn-info {
      background: linear-gradient(135deg, var(--neural-cyan), var(--neural-purple));
    }

    .btn-home     { background: linear-gradient(135deg, #22c55e, var(--neural-cyan)); }
    .btn-features { background: linear-gradient(135deg, var(--neural-cyan), var(--neural-blue)); }
    .btn-founder  { background: linear-gradient(135deg, var(--neural-purple), var(--neural-pink)); }
    .btn-contact  { background: linear-gradient(135deg, var(--neural-pink), #fb923c); }
    .btn-login    { background: linear-gradient(135deg, #6366f1, var(--neural-pink)); }

    .btn:hover {
      transform: translateY(-4px) scale(1.05);
      box-shadow: 0 0 30px rgba(59,130,246,0.7);
    }

    .fab-actions {
      position: absolute;
      bottom: 4.4rem;
      right: 0.35rem;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      transform-origin: bottom right;
      transform: scale(0.9);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-speed) ease,
                  transform var(--transition-speed) ease;
    }

    .fab:hover .fab-actions,
    .fab:focus-within .fab-actions {
      transform: scale(1);
      opacity: 1;
      pointer-events: auto;
    }

    .tooltip {
      position: relative;
    }

    .tooltip::after {
      content: attr(data-tip);
      position: absolute;
      right: 110%;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(15,23,42,0.95);
      color: #e5e7eb;
      padding: 0.35rem 0.7rem;
      border-radius: 999px;
      font-size: 0.75rem;
      white-space: nowrap;
      opacity: 0;
      transition: opacity var(--transition-speed) ease,
                  transform var(--transition-speed) ease;
      border: 1px solid rgba(148,163,184,0.5);
    }

    .tooltip:hover::after,
    .tooltip:focus-within::after {
      opacity: 1;
      transform: translate(-0.4rem, -50%);
    }

    @media (max-width: 900px) {
      .glass {
        max-width: 96vw;
        padding: 2rem 1.4rem;
      }
      h2 { font-size: 2rem; }
    }

    @media (max-width: 640px) {
      .section { padding: 2.2rem 0.6rem; }
      h2 { font-size: 1.6rem; }
      p  { font-size: 0.98rem; }
      .btn-lg {
        width: 3rem;
        height: 3rem;
        font-size: 0.95rem;
      }
    }

    /* CampusHelp shared journey frame: additive styles, keeping each page's original content intact. */
    .campus-frame-header { position: sticky; top: 10px; z-index: 5; width: min(1180px, calc(100% - 40px)); min-height: 68px; margin: 0 auto; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border: 1px solid rgba(255,255,255,.18); border-radius: 0 0 18px 18px; background: rgba(9, 17, 35, .82); color: #f8fafc; box-shadow: 0 12px 32px rgba(2,6,23,.15); backdrop-filter: blur(14px); }
    .campus-wordmark { display: inline-flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; font-weight: 750; letter-spacing: .01em; white-space: nowrap; }
    .campus-mark { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 11px; background: linear-gradient(145deg,#73d6c5,#9c8df2); color: #101a35; font-weight: 850; }
    .campus-frame-header nav { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 10px 20px; }
    .campus-frame-header nav a { color: #e0e7ff; text-decoration: none; font-size: .88rem; font-weight: 600; }
    .campus-frame-header nav a:hover { color: #83e0d1; }
    .campus-frame-header nav .campus-next { padding: 9px 14px; border-radius: 999px; background: #a7f0df; color: #10243a; }
    .campus-flow-label { color: #bdc9df; font-size: .78rem; letter-spacing: .03em; }
    .campus-frame-footer { position: relative; z-index: 2; width: min(1180px, calc(100% - 40px)); margin: 28px auto 14px; padding: 12px 18px; display: flex; justify-content: space-between; gap: 12px; color: #cbd5e1; font-size: .76rem; letter-spacing: .07em; text-transform: uppercase; }
    @media (max-width: 620px) { .campus-frame-header { width: calc(100% - 20px); padding: 11px 13px; align-items: flex-start; } .campus-frame-header nav { gap: 8px 12px; } .campus-frame-header nav a { font-size: .78rem; } .campus-flow-label { width: 100%; text-align: right; } .campus-frame-footer { width: calc(100% - 28px); flex-wrap: wrap; } }
    body { overflow-x: hidden; }
    /* CampusHelp building journey: one skyline hero followed by three readable story floors. */
    html { scroll-snap-type: y proximity; }
    .campus-frame-header { width: min(1240px, calc(100% - 48px)); margin-top: 14px; border-radius: 18px; }
    .section { min-height: 92vh; scroll-snap-align: start; padding: clamp(36px, 7vh, 88px) clamp(18px, 5vw, 72px); }
    .section#intro { min-height: calc(100vh - 82px); }
    .glass { width: min(1100px, 100%); max-width: 1100px; margin: 0 auto; padding: clamp(30px, 5vw, 64px); border-radius: 30px; background: linear-gradient(135deg, rgba(16,31,56,.94), rgba(21,35,63,.84)); border-color: rgba(173,199,230,.3); box-shadow: 0 28px 80px rgba(3,10,28,.42); animation: none; }
    .glass:hover { transform: translateY(-3px); border-color: rgba(167,240,223,.65); box-shadow: 0 34px 88px rgba(3,10,28,.48); }
    .glass::before { background: radial-gradient(ellipse at 82% 48%, rgba(117,205,203,.16), transparent 42%); opacity: 1; }
    .glass h2 { position: relative; z-index: 1; max-width: 710px; font-size: clamp(2rem, 4vw, 3.7rem); line-height: 1.08; margin-bottom: 1.25rem; }
    .glass p, .features-list { max-width: 720px; }
    .section#intro .glass { min-height: min(590px, 75vh); display: flex; flex-direction: column; justify-content: center; padding-right: min(42%, 460px); overflow: hidden; }
    .section#intro .glass::after { content: ''; position: absolute; right: 5%; bottom: 0; width: 36%; height: 88%; opacity: .88; background: linear-gradient(0deg, rgba(121,212,201,.35), transparent 20%), linear-gradient(90deg, transparent 15%, #243e66 15% 28%, transparent 28% 33%, #34547d 33% 48%, transparent 48% 54%, #203a61 54% 70%, transparent 70% 75%, #45658d 75% 91%, transparent 91%), repeating-linear-gradient(0deg, transparent 0 48px, rgba(185,225,231,.32) 49px 51px), repeating-linear-gradient(90deg, transparent 0 42px, rgba(185,225,231,.24) 43px 45px); clip-path: polygon(0 20%, 22% 20%, 22% 0, 42% 0, 42% 13%, 65% 13%, 65% 4%, 82% 4%, 82% 26%, 100% 26%, 100% 100%, 0 100%); mask-image: linear-gradient(90deg, transparent, #000 22%); pointer-events: none; }
    .section#founder .glass, .section#features .glass, .section#contact .glass { width: min(1120px, 100%); min-height: 470px; padding-right: 34%; display: flex; flex-direction: column; justify-content: center; }
    .section#founder .glass::after, .section#features .glass::after, .section#contact .glass::after { content: ''; position: absolute; right: 4%; top: 12%; bottom: 12%; width: 25%; border: 1px solid rgba(163,201,224,.44); border-radius: 13px; background: linear-gradient(0deg, transparent calc(33.33% - 1px), rgba(163,201,224,.58) calc(33.33% - 1px) 33.33%, transparent 33.33% calc(66.66% - 1px), rgba(163,201,224,.58) calc(66.66% - 1px) 66.66%, transparent 66.66%), repeating-linear-gradient(90deg, transparent 0 31%, rgba(163,201,224,.28) 31.5% 32.5%, transparent 33%), linear-gradient(135deg, rgba(118,213,201,.17), rgba(137,136,239,.12)); box-shadow: inset 0 0 0 9px rgba(173,199,230,.06), 0 16px 50px rgba(2,8,24,.22); pointer-events: none; }
    .section#founder .glass::before, .section#features .glass::before, .section#contact .glass::before { inset: auto 4% 12%; width: 25%; height: 1px; background: rgba(163,201,224,.62); }
    .section#founder .glass::after { background-color: rgba(227,188,146,.09); }
    .section#features .glass::after { background-color: rgba(130,176,210,.1); }
    .section#contact .glass::after { background-color: rgba(134,211,185,.1); }
    .section#features .features-list li { margin-bottom: .62rem; line-height: 1.5; }
    .contact-form, .login-form { width: min(100%, 560px); max-width: 560px; }
    .campus-frame-footer { border-top: 1px solid rgba(203,213,225,.18); }
    .fab { bottom: 28px; }
    @media (max-width: 760px) { html { scroll-snap-type: none; } .section, .section#intro { min-height: auto; padding: 32px 12px; } .glass { width: 100%; padding: 32px 24px; } .section#intro .glass { min-height: 580px; padding: 34px 25px 220px; } .section#intro .glass::after { width: 75%; height: 38%; right: 0; opacity: .65; } .section#founder .glass, .section#features .glass, .section#contact .glass { min-height: 530px; padding: 34px 25px 220px; } .section#founder .glass::after, .section#features .glass::after, .section#contact .glass::after { width: 74%; height: 32%; top: auto; bottom: 7%; right: 13%; } .section#founder .glass::before, .section#features .glass::before, .section#contact .glass::before { display:none; } }

    .fab { bottom: 82px; }



    .building-camera { position:fixed; inset:0; z-index:0; width:100vw; height:100vh; pointer-events:none; overflow:hidden; }
    #student-floor-1, #student-floor-2, #student-floor-3 { transition:opacity .35s ease; }
    #camera-interior { filter:drop-shadow(0 24px 30px rgba(65,77,112,.12)); }
    #camera-city, #camera-interior { will-change:transform,opacity; transition:opacity .28s linear; }
    #camera-interior { transition:opacity .28s linear, transform .55s cubic-bezier(.2,.72,.2,1); }
    .wrapper { z-index:1; padding-bottom:0; }
    .content { z-index:1; }
    .section { min-height:100vh; padding:clamp(32px,7vh,80px) clamp(18px,6vw,88px); }
    .section#intro { min-height:100vh; padding:0 clamp(18px,6vw,88px); }
    .section#intro .glass { position:relative; width:min(1280px,100%); max-width:none; min-height:100vh; height:100vh; margin:0 auto; padding:105px 0 60px; display:flex; align-items:center; justify-content:flex-start; overflow:visible; border:0; border-radius:0; background:transparent; box-shadow:none; backdrop-filter:none; }
    .section#intro .glass::before, .section#intro .glass::after, .section#intro .hero-city-art { display:none !important; }
    .hero-copy { position:relative; z-index:2; width:min(640px,48vw); padding:clamp(24px,4vw,54px); border-radius:30px; border:1px solid rgba(255,255,255,.56); background:linear-gradient(100deg,rgba(255,249,242,.93),rgba(255,249,242,.76) 70%,rgba(255,249,242,0)); box-shadow:0 22px 64px rgba(71,84,125,.1); }
    .section#intro .glass h2 { max-width:640px; color:#536fa8; background:linear-gradient(115deg,#527bb0,#7b83c1 68%,#b57d95); -webkit-background-clip:text; background-clip:text; text-shadow:none; font-size:clamp(2.5rem,5vw,4.8rem); }
    .section#intro .glass p { max-width:620px; color:#53647a; text-shadow:none; font-size:clamp(1rem,1.3vw,1.15rem); }
    .section#founder .glass, .section#features .glass, .section#contact .glass { width:min(570px,47vw); min-height:480px; margin:0 auto 0 2%; padding:clamp(28px,4vw,54px); background:rgba(255,248,241,.91); border:1px solid rgba(255,255,255,.75); border-radius:28px; box-shadow:0 24px 68px rgba(74,84,125,.14); backdrop-filter:blur(10px); }
    .section#founder .glass::before, .section#features .glass::before, .section#contact .glass::before, .section#founder .glass::after, .section#features .glass::after, .section#contact .glass::after, .room-building-art { display:none !important; }
    .section#founder .glass h2, .section#features .glass h2, .section#contact .glass h2 { font-size:clamp(2rem,3.4vw,3rem); }
    .section#founder .glass p, .section#features .glass li, .section#contact .glass p { color:#53647a; }
    .section#features .glass { background:rgba(246,247,255,.92); }
    .section#contact .glass { background:rgba(255,246,242,.93); }
    .section#founder .contact-form, .section#features .contact-form, .section#contact .contact-form { max-width:100%; }
    .section#login .glass { background:rgba(255,250,246,.94); color:#34445e; }
    .section#login { position:relative; z-index:2; background:linear-gradient(135deg,rgba(255,247,242,.92),rgba(242,244,255,.94)); }
    .campus-frame-header { z-index:10; }
    .fab { z-index:11; }
    @media(max-width:760px) {
      .section#intro { padding:0 14px; }
      .section#intro .glass { min-height:100svh; height:100svh; padding:100px 0 32px; }
      .hero-copy { width:100%; padding:27px 22px; background:rgba(255,249,242,.86); }
      .section#founder .glass, .section#features .glass, .section#contact .glass { width:100%; min-height:440px; margin:0; }
    }

    .campus-svg-defs { position:absolute; width:0; height:0; overflow:hidden; }
    .section#intro .glass { padding-right:min(46%,520px); }
    .section#intro .glass::after { display:none; }
    .hero-city-art { position:absolute; z-index:0; inset:0; width:100%; height:100%; object-fit:cover; transform-origin:57% 40%; transition:transform 90ms linear,opacity 100ms linear; will-change:transform,opacity; }
    .section#intro .glass h2, .section#intro .glass p { position:relative; z-index:2; text-shadow:0 1px 12px rgba(255,250,245,.8); }
    .section#intro .glass h2 { max-width:640px; }
    .section#intro .glass p { max-width:620px; }
    .section#founder .glass::after, .section#features .glass::after, .section#contact .glass::after, .section#founder .glass::before, .section#features .glass::before, .section#contact .glass::before { display:none; }
    .section#founder .glass, .section#features .glass, .section#contact .glass { padding-right:34%; overflow:visible; }
