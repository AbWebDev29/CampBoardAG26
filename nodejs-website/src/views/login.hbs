<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Effortless College Journey</title>

  <style>
    :root {
      --bg-primary: #030712;
      --bg-secondary: rgba(15, 23, 42, 0.85);
      --bg-tertiary: #020617;

      --text-primary: #e5e7eb;
      --text-secondary: #9ca3af;

      --neural-cyan: #22d3ee;
      --neural-purple: #7c3aed;
      --neural-pink: #ec4899;
      --neural-blue: #3b82f6;

      --border-color: rgba(148, 163, 184, 0.4);
      --transition-speed: 0.35s;
    }

    @keyframes bgShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 20px rgba(34, 211, 238, 0.25); }
      50% {
        box-shadow:
          0 0 40px rgba(34, 211, 238, 0.5),
          0 0 30px rgba(124, 58, 237, 0.35);
      }
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      scroll-behavior: smooth;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
    }

    body {
      background:
        radial-gradient(circle at 0% 0%, #1d4ed8 0, transparent 55%),
        radial-gradient(circle at 100% 100%, #7c3aed 0, transparent 55%),
        linear-gradient(135deg, #020617 0%, #0b1120 50%, #020617 100%);
      background-size: 200% 200%;
      animation: bgShift 18s ease-in-out infinite;
      position: relative;
      overflow-x: hidden;
    }

    /* Grid overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: url('data:image/svg+xml,<svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="grid" width="80" height="80" patternUnits="userSpaceOnUse"><path d="M 80 0 L 0 0 0 80" fill="none" stroke="rgba(148,163,184,0.18)" stroke-width="0.5"/></pattern></defs><rect width="100%" height="100%" fill="url(%23grid)"/></svg>');
      pointer-events: none;
      opacity: 0.5;
      z-index: 0;
    }

    /* Corner triangles background */
    .background-container {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .triangle-group-1,
    .triangle-group-2 {
      position: absolute;
      width: 480px;
      height: 480px;
      transform-origin: center center;
      will-change: transform;
      opacity: 0.95;
    }

    /* bottom-left red/yellow */
    .triangle-group-1 {
      bottom: 0;
      left: 0;
      transform: translate(-40%, 40%) rotate(325.932deg);
    }

    /* top-right red/purple/blue */
    .triangle-group-2 {
      top: 0;
      right: 0;
      transform: translate(40%, -40%) rotate(251.777deg);
    }

    .wrapper {
      position: relative;
      min-height: 100vh;
      z-index: 1;
      padding-bottom: 4rem;
    }

    .content {
      position: relative;
      width: 100%;
      z-index: 1;
    }

    .section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 1rem;
    }

    /* Glass cards – simplified, higher contrast */
    .glass {
      max-width: 720px;
      width: 90%;
      margin: 2rem auto 0 auto;
      padding: 2.5rem 2rem;
      border-radius: 18px;
      background: linear-gradient(
        145deg,
        rgba(15, 23, 42, 0.9),
        rgba(15, 23, 42, 0.7)
      );
      border: 1px solid var(--border-color);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow:
        0 18px 60px rgba(15, 23, 42, 0.95),
        0 0 40px rgba(15, 23, 42, 0.9);
      transition: transform var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease,
                  border-color var(--transition-speed) ease;
      animation: pulseGlow 10s ease-in-out infinite;
      position: relative;
      overflow: hidden;
    }

    .glass:hover {
      transform: translateY(-6px);
      border-color: rgba(148, 163, 184, 0.8);
      box-shadow:
        0 25px 80px rgba(15, 23, 42, 1),
        0 0 60px rgba(56, 189, 248, 0.35);
    }

    .glass::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top left,
        rgba(56,189,248,0.18),
        transparent 55%);
      opacity: 0.7;
      pointer-events: none;
    }

    .glass > * {
      position: relative;
      z-index: 1;
    }

    h2 {
      font-size: 2.4rem;
      margin-bottom: 1.5rem;
      letter-spacing: -0.03em;
      font-weight: 700;
      background: linear-gradient(135deg,
        var(--neural-cyan),
        var(--neural-blue),
        var(--neural-purple),
        var(--neural-pink));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    p {
      font-size: 1.06rem;
      line-height: 1.8;
      color: var(--text-secondary);
    }

    ul.features-list {
      padding-left: 1.4rem;
      margin-top: 0.5rem;
    }

    ul.features-list li {
      margin-bottom: 0.8rem;
      color: var(--text-secondary);
      font-size: 1.02rem;
    }

    ul.features-list li::before {
      content: '•';
      color: var(--neural-cyan);
      margin-right: 0.45rem;
      font-size: 1.15rem;
    }

    .contact-form,
    .login-form {
      max-width: 420px;
      margin-top: 1.6rem;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.45rem;
      font-size: 0.9rem;
      color: var(--text-secondary);
    }

    .contact-form input,
    .contact-form textarea,
    .login-form input {
      width: 100%;
      padding: 0.85rem 1rem;
      border-radius: 10px;
      border: 1px solid var(--border-color);
      background: rgba(15, 23, 42, 0.85);
      color: var(--text-primary);
      font-size: 0.98rem;
      outline: none;
      transition: border-color var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease,
                  background var(--transition-speed) ease,
                  transform var(--transition-speed) ease;
      backdrop-filter: blur(10px);
    }

    .contact-form input::placeholder,
    .contact-form textarea::placeholder,
    .login-form input::placeholder {
      color: #6b7280;
    }

    .contact-form input:focus,
    .contact-form textarea:focus,
    .login-form input:focus {
      border-color: var(--neural-cyan);
      box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.5);
      transform: translateY(-1px);
      background: rgba(15, 23, 42, 0.95);
    }

    .contact-form textarea {
      resize: vertical;
      min-height: 100px;
    }

    .contact-form button,
    .login-form button[type="submit"] {
      width: 100%;
      padding: 0.95rem;
      border-radius: 999px;
      border: none;
      background: linear-gradient(135deg,
        var(--neural-cyan),
        var(--neural-blue),
        var(--neural-purple));
      color: #f9fafb;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      box-shadow:
        0 10px 30px rgba(59,130,246,0.45),
        0 0 25px rgba(59,130,246,0.6);
      transition: transform var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease;
    }

    .contact-form button:hover,
    .login-form button[type="submit"]:hover {
      transform: translateY(-3px);
      box-shadow:
        0 18px 40px rgba(59,130,246,0.6),
        0 0 35px rgba(236,72,153,0.7);
    }

    .contact-form button:active,
    .login-form button[type="submit"]:active {
      transform: translateY(-1px);
    }

    .login-form .form-footer {
      margin-top: 1.3rem;
      font-size: 0.9rem;
      color: var(--text-secondary);
      text-align: center;
    }

    .login-form .form-footer a {
      color: var(--neural-cyan);
      text-decoration: none;
      font-weight: 500;
    }

    .login-form .form-footer a:hover {
      text-decoration: underline;
    }

    /* FAB nav – keep as is, but no theme button */
    .fab {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      z-index: 3;
    }

    .btn {
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      border-radius: 999px;
      transition: transform var(--transition-speed) ease,
                  box-shadow var(--transition-speed) ease;
      color: #f9fafb;
    }

    .btn-circle {
      border-radius: 50%;
    }

    .btn-lg {
      width: 3.4rem;
      height: 3.4rem;
      font-size: 1.05rem;
    }

    .btn-info {
      background: linear-gradient(135deg, var(--neural-cyan), var(--neural-purple));
    }

    .btn-home     { background: linear-gradient(135deg, #22c55e, var(--neural-cyan)); }
    .btn-features { background: linear-gradient(135deg, var(--neural-cyan), var(--neural-blue)); }
    .btn-founder  { background: linear-gradient(135deg, var(--neural-purple), var(--neural-pink)); }
    .btn-contact  { background: linear-gradient(135deg, var(--neural-pink), #fb923c); }
    .btn-login    { background: linear-gradient(135deg, #6366f1, var(--neural-pink)); }

    .btn:hover {
      transform: translateY(-4px) scale(1.05);
      box-shadow: 0 0 30px rgba(59,130,246,0.7);
    }

    .fab-actions {
      position: absolute;
      bottom: 4.4rem;
      right: 0.35rem;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      transform-origin: bottom right;
      transform: scale(0.9);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-speed) ease,
                  transform var(--transition-speed) ease;
    }

    .fab:hover .fab-actions,
    .fab:focus-within .fab-actions {
      transform: scale(1);
      opacity: 1;
      pointer-events: auto;
    }

    .tooltip {
      position: relative;
    }

    .tooltip::after {
      content: attr(data-tip);
      position: absolute;
      right: 110%;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(15,23,42,0.95);
      color: #e5e7eb;
      padding: 0.35rem 0.7rem;
      border-radius: 999px;
      font-size: 0.75rem;
      white-space: nowrap;
      opacity: 0;
      transition: opacity var(--transition-speed) ease,
                  transform var(--transition-speed) ease;
      border: 1px solid rgba(148,163,184,0.5);
    }

    .tooltip:hover::after,
    .tooltip:focus-within::after {
      opacity: 1;
      transform: translate(-0.4rem, -50%);
    }

    @media (max-width: 900px) {
      .glass {
        max-width: 96vw;
        padding: 2rem 1.4rem;
      }
      h2 { font-size: 2rem; }
    }

    @media (max-width: 640px) {
      .section { padding: 2.2rem 0.6rem; }
      h2 { font-size: 1.6rem; }
      p  { font-size: 0.98rem; }
      .btn-lg {
        width: 3rem;
        height: 3rem;
        font-size: 0.95rem;
      }
    }
  </style>
</head>
<body>
  <!-- Corner background triangles -->
  <div class="background-container">
    <div class="triangle-group-1" id="triangle1">
      <svg width="100%" height="100%" viewBox="0 0 388 387" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g>
          <path
            d="M116.13 125.931C113.934 106.917 133.046 92.5888 150.681 100.028L291.135 159.272C308.916 166.772 311.855 190.733 296.416 202.309L173.456 294.495C158.016 306.071 135.839 296.532 133.624 277.362L116.13 125.931Z"
            fill="url(#gradient1)" />
          <path
            d="M141.702 155.147C139.265 135.955 158.615 121.386 176.385 129.033L248.166 159.923C265.797 167.51 268.655 191.313 253.321 202.859L191.385 249.492C176.051 261.037 153.965 251.711 151.547 232.669L141.702 155.147Z"
            fill="black" />
        </g>
        <defs>
          <linearGradient id="gradient1" x1="304.91" y1="110.015" x2="82.4806" y2="276.775" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#FF0D0D"/>
            <stop offset="1" stop-color="#E7D000"/>
          </linearGradient>
        </defs>
      </svg>
    </div>

    <div class="triangle-group-2" id="triangle2">
      <svg width="100%" height="100%" viewBox="0 0 388 387" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g>
          <path
            d="M116.13 125.931C113.934 106.917 133.046 92.5888 150.681 100.028L291.135 159.272C308.916 166.772 311.855 190.733 296.416 202.309L173.456 294.495C158.016 306.071 135.839 296.532 133.624 277.362L116.13 125.931Z"
            fill="url(#gradient2)" />
          <path
            d="M141.702 155.147C139.265 135.955 158.615 121.386 176.385 129.033L248.166 159.923C265.797 167.51 268.655 191.313 253.321 202.859L191.385 249.492C176.051 261.037 153.965 251.711 151.547 232.669L141.702 155.147Z"
            fill="black" />
        </g>
        <defs>
          <linearGradient id="gradient2" x1="304.91" y1="110.015" x2="82.4806" y2="276.775" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#FF0D0D"/>
            <stop offset="0.576923" stop-color="#2915A5"/>
            <stop offset="1" stop-color="#000DC8"/>
          </linearGradient>
        </defs>
      </svg>
    </div>
  </div>

  <!-- FAB NAVIGATION -->
  <div class="fab fab-flower">
    <div tabindex="0" role="button"
         class="btn btn-lg btn-info btn-circle"
         title="Open navigation">≡</div>

    <div class="fab-actions">
      <div class="tooltip" data-tip="Home">
        <button class="btn btn-lg btn-circle btn-home"
                onclick="document.getElementById('intro').scrollIntoView({behavior:'smooth'})">H</button>
      </div>
      <div class="tooltip" data-tip="Features">
        <button class="btn btn-lg btn-circle btn-features"
                onclick="document.getElementById('features').scrollIntoView({behavior:'smooth'})">F</button>
      </div>
      <div class="tooltip" data-tip="Founder">
        <button class="btn btn-lg btn-circle btn-founder"
                onclick="document.getElementById('founder').scrollIntoView({behavior:'smooth'})">A</button>
      </div>
      <div class="tooltip" data-tip="Contact">
        <button class="btn btn-lg btn-circle btn-contact"
                onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">C</button>
      </div>
      <div class="tooltip" data-tip="Login">
        <button class="btn btn-lg btn-circle btn-login"
                onclick="document.getElementById('login').scrollIntoView({behavior:'smooth'})">L</button>
      </div>
    </div>
  </div>

  <div class="wrapper">
    <div class="content">
      <!-- INTRO SECTION -->
      <section id="intro" class="section">
        <div class="glass">
          <h2>Welcome to Effortless College Journey</h2>
          <p>
            Are you feeling overwhelmed by the college application process? Our platform is dedicated to guiding you every step of the way, from researching the perfect colleges to submitting your applications and preparing for campus life.
            <br><br>
            Whether you need help choosing the right course, crafting a standout application, finding scholarships, or navigating admissions interviews, our expert resources and personalized support are designed to make your college journey smooth and effortless.
          </p>
        </div>
      </section>

      <!-- FEATURES SECTION -->
      <section id="features" class="section">
        <div class="glass">
          <h2>Key Features</h2>
          <ul class="features-list">
            <li>Personalized college and course recommendations</li>
            <li>Step-by-step application guidance</li>
            <li>Scholarship and financial aid discovery</li>
            <li>Mock interviews and resume-building tools</li>
            <li>Expert advice and real student stories</li>
            <li>Secure document management</li>
          </ul>
        </div>
      </section>

      <!-- FOUNDER SECTION -->
      <section id="founder" class="section">
        <div class="glass">
          <h2>About the Founder</h2>
          <p>
            Our founder is passionate about making higher education accessible and stress-free for everyone. With experience in education consulting and a deep understanding of student needs, this platform was created to empower students and families to make informed decisions and achieve their academic dreams.
          </p>
        </div>
      </section>

      <!-- CONTACT SECTION -->
      <section id="contact" class="section">
        <div class="glass">
          <h2>Contact Us</h2>
          <p>
            Have questions or need personalized guidance? Reach out — we are here to help.
          </p>
          <form class="contact-form" action="#" method="post">
            <div class="form-group">
              <label for="contact-name">Name</label>
              <input type="text" id="contact-name" name="name" required>
            </div>
            <div class="form-group">
              <label for="contact-email">Email</label>
              <input type="email" id="contact-email" name="email" required>
            </div>
            <div class="form-group">
              <label for="contact-message">Message</label>
              <textarea id="contact-message" name="message" rows="4" required></textarea>
            </div>
            <button type="submit">Send Message</button>
          </form>
        </div>
      </section>

      <!-- LOGIN SECTION -->
      <section id="login" class="section">
        <div class="glass">
          <h2>Login</h2>
          <form class="login-form" action="/login" method="post">
            <div class="form-group">
              <label for="login-email">Email</label>
              <input type="email" id="login-email" name="email" required>
            </div>
            <div class="form-group">
              <label for="login-password">Password</label>
              <input type="password" id="login-password" name="password" required>
            </div>
            <button type="submit">Login</button>
            <div class="form-footer">
              Don&apos;t have an account? <a href="/signup">Sign Up</a>
            </div>
          </form>
        </div>
      </section>
    </div>
  </div>

  <script>
    // scroll‑driven triangle motion
    const triangle1 = document.getElementById('triangle1');
    const triangle2 = document.getElementById('triangle2');

    const initialRotation1 = 325.932;
    const initialRotation2 = 251.777;

    let ticking = false;

    function updateTriangles() {
      const scrollY = window.scrollY || window.pageYOffset;
      const windowHeight = window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;
      const maxScroll = documentHeight - windowHeight || 1;

      const scrollPercent = Math.min(1, Math.max(0, scrollY / maxScroll));

      const rotate1 = initialRotation1 + scrollPercent * 180;
      const translateX1 = scrollPercent * 80;
      const translateY1 = Math.sin(scrollPercent * Math.PI * 2) * 40;
      const scale1 = 1 + Math.sin(scrollPercent * Math.PI * 2) * 0.08;

      const rotate2 = initialRotation2 - scrollPercent * 180;
      const translateX2 = -scrollPercent * 80;
      const translateY2 = Math.cos(scrollPercent * Math.PI * 2) * 40;
      const scale2 = 1 + Math.cos(scrollPercent * Math.PI * 2) * 0.08;

      triangle1.style.transform = `
        translate(-40%, 40%)
        translate(${translateX1}px, ${translateY1}px)
        rotate(${rotate1}deg)
        scale(${scale1})
      `;

      triangle2.style.transform = `
        translate(40%, -40%)
        translate(${translateX2}px, ${translateY2}px)
        rotate(${rotate2}deg)
        scale(${scale2})
      `;

      ticking = false;
    }

    function requestTick() {
      if (!ticking) {
        window.requestAnimationFrame(updateTriangles);
        ticking = true;
      }
    }

    window.addEventListener('scroll', requestTick);
    window.addEventListener('resize', updateTriangles);
    updateTriangles();
  </script>
</body>
</html>
