    /* Dreamy CampusHelp palette inspired by the supplied skyline and room references. */
    :root { --bg-primary:#f8f5f3; --bg-secondary:rgba(255,255,255,.9); --bg-tertiary:#fffaf5; --text-primary:#273953; --text-secondary:#64738a; --text-tertiary:#7b8797; --neural-cyan:#59bdbb; --neural-purple:#8494e8; --neural-pink:#ee94a9; --neural-blue:#648ce2; --border-color:rgba(80,111,146,.2); }
    body { background:radial-gradient(ellipse at 12% 0%,#fff0dc 0,transparent 40%),radial-gradient(ellipse at 92% 14%,#e8e5ff 0,transparent 43%),linear-gradient(145deg,#f8f4ed,#fff7f3 48%,#f1f4fc); color:#293b55; }
    body::before { opacity:0; background-image:none; }
    .background-container { display:none !important; }
    .campus-frame-header { background:rgba(255,252,248,.88); color:#293b55; border-color:rgba(80,111,146,.18); box-shadow:0 12px 32px rgba(74,86,120,.1); }
    .campus-mark { background:linear-gradient(145deg,#a9e3d5,#c3c3f3); color:#293b55; }
    .campus-frame-header nav a { color:#405675; }
    .campus-frame-header nav .campus-next { background:linear-gradient(110deg,#a9e3d5,#c8d5ff); color:#273953; }
    .campus-flow-label { color:#75839a; }
    .campus-frame-footer { color:#78849a; border-color:rgba(80,111,146,.18); }
    input, textarea, select { accent-color:#6dbeb7; }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior:auto !important; animation-duration:.01ms !important; transition-duration:.01ms !important; } }

    body { background:radial-gradient(ellipse at 10% 0%,#ffe5c6 0,transparent 40%),radial-gradient(ellipse at 90% 20%,#e7dcff 0,transparent 42%),linear-gradient(150deg,#f8f1e9,#fff7f5 55%,#eef3ff); color:#34445e; }
    .glass { background:linear-gradient(135deg,rgba(255,250,245,.96),rgba(255,255,255,.89)); border-color:rgba(92,119,155,.2); box-shadow:0 25px 70px rgba(91,91,138,.13); }
    .glass:hover { border-color:rgba(104,168,174,.48); box-shadow:0 30px 74px rgba(91,91,138,.16); }
    .glass::before { background:radial-gradient(ellipse at 82% 48%,rgba(238,161,165,.22),transparent 46%); }
    .glass h2 { background:linear-gradient(115deg,#477db8,#7284d2 52%,#bc7ea3); -webkit-background-clip:text; background-clip:text; }
    .glass p, .features-list li, .form-group label, .login-form .form-footer { color:#5e6d82; }
    .section#intro .glass::after { opacity:.78; background:linear-gradient(0deg,rgba(240,180,166,.42),transparent 22%),linear-gradient(90deg,transparent 15%,#e9a898 15% 28%,transparent 28% 33%,#8fa9d4 33% 48%,transparent 48% 54%,#9f9bd2 54% 70%,transparent 70% 75%,#f1c6a5 75% 91%,transparent 91%),repeating-linear-gradient(0deg,transparent 0 48px,rgba(255,255,255,.68) 49px 51px),repeating-linear-gradient(90deg,transparent 0 42px,rgba(255,255,255,.44) 43px 45px); }
    .section#founder .glass::after, .section#features .glass::after, .section#contact .glass::after { border-color:rgba(98,133,167,.35); background-color:rgba(255,255,255,.42); background-image:linear-gradient(0deg,transparent calc(33.33% - 1px),rgba(125,160,184,.38) calc(33.33% - 1px) 33.33%,transparent 33.33% calc(66.66% - 1px),rgba(125,160,184,.38) calc(66.66% - 1px) 66.66%,transparent 66.66%),repeating-linear-gradient(90deg,transparent 0 31%,rgba(125,160,184,.26) 31.5% 32.5%,transparent 33%),linear-gradient(135deg,rgba(255,226,202,.72),rgba(216,221,255,.62)); box-shadow:inset 0 0 0 9px rgba(255,255,255,.32),0 16px 50px rgba(76,92,132,.12); }
    .section#founder .glass::before, .section#features .glass::before, .section#contact .glass::before { background:rgba(125,160,184,.45); }
    .contact-form input, .contact-form textarea, .login-form input { background:rgba(255,255,255,.86); border-color:rgba(89,119,153,.25); color:#293b55; }
    .contact-form input:focus, .contact-form textarea:focus, .login-form input:focus { background:#fff; border-color:#6dbeb7; box-shadow:0 0 0 3px rgba(109,190,183,.18); }
    .contact-form button, .login-form button[type="submit"] { background:linear-gradient(110deg,#73c9bd,#8294e8); box-shadow:0 10px 24px rgba(112,151,200,.23); }
    .login-form .form-footer a { color:#527fba; }
    .fab .btn-circle { background:linear-gradient(140deg,#80d1c3,#9a9ee9); box-shadow:0 8px 22px rgba(109,139,201,.24); }
    .tooltip::after { background:#fffaf5; color:#435772; border-color:rgba(98,133,167,.28); }
    .campus-frame-header nav a:hover { color:#548d91; }

    /* Floor-card alignment: release the width reserved for the former in-card illustration. */
    .section#founder .glass, .section#features .glass, .section#contact .glass { width:min(640px,48vw); padding-right:clamp(28px,4vw,54px) !important; box-sizing:border-box; }
    .section#founder .glass, .section#features .glass, .section#contact .glass { margin-left:2%; margin-right:auto; }
    .section#features .glass h2 { width:100%; max-width:none; white-space:normal; overflow-wrap:normal; word-break:normal; }
    .section#features ul.features-list { width:100%; max-width:none; padding:0; list-style:none; }
    .section#features .features-list li { position:relative; width:100%; padding-left:1.25rem; margin:0 0 .72rem; line-height:1.45; overflow-wrap:normal; }
    .section#features .features-list li::before { position:absolute; left:0; top:0; margin:0; }
    @media (min-width:761px) and (max-width:1000px) { .section#founder .glass, .section#features .glass, .section#contact .glass { width:min(640px,52vw); } }
    @media(max-width:760px) {
