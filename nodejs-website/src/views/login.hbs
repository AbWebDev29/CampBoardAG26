  <div class="wrapper">
    <div class="content">
      <!-- INTRO SECTION -->
      <section id="intro" class="section">
        <div class="glass">
          <div class="hero-copy">
          <svg class="hero-city-art" viewBox="0 0 1440 820" role="img" aria-label="Pastel New York skyline with a landmark art deco tower"><use href="#campus-nyc-skyline" x="0" y="0" width="1440" height="820"></use></svg>
          <h2>Welcome to Effortless College Journey</h2>
          <p>
            Are you feeling overwhelmed by the college application process? Our platform is dedicated to guiding you every step of the way, from researching the perfect colleges to submitting your applications and preparing for campus life.
            <br><br>
            Whether you need help choosing the right course, crafting a standout application, finding scholarships, or navigating admissions interviews, our expert resources and personalized support are designed to make your college journey smooth and effortless.
          </p>
          </div>
        </div>
      </section>

      <!-- FOUNDER SECTION -->
      <section id="founder" class="section">
        <div class="glass">
          <svg class="room-building-art" viewBox="0 0 420 560" role="img" aria-label="Isometric three-floor building interior with a New York skyline"><use href="#campus-building-cutaway" x="0" y="0" width="420" height="560"></use></svg>
          <h2>About the Founder</h2>
          <p>
            Our founder is passionate about making higher education accessible and stress-free for everyone. With experience in education consulting and a deep understanding of student needs, this platform was created to empower students and families to make informed decisions and achieve their academic dreams.
          </p>
        </div>
      </section>

      <!-- FEATURES SECTION -->
      <section id="features" class="section">
        <div class="glass">
          <svg class="room-building-art" viewBox="0 0 420 560" role="img" aria-label="Isometric three-floor building interior with a New York skyline"><use href="#campus-building-cutaway" x="0" y="0" width="420" height="560"></use></svg>
          <h2>Key Features</h2>
          <ul class="features-list">
            <li>Personalized college and course recommendations</li>
            <li>Step-by-step application guidance</li>
            <li>Scholarship and financial aid discovery</li>
            <li>Mock interviews and resume-building tools</li>
            <li>Expert advice and real student stories</li>
            <li>Secure document management</li>
          </ul>
        </div>
      </section>

      <!-- CONTACT SECTION -->
      <section id="contact" class="section">
        <div class="glass">
          <svg class="room-building-art" viewBox="0 0 420 560" role="img" aria-label="Isometric three-floor building interior with a New York skyline"><use href="#campus-building-cutaway" x="0" y="0" width="420" height="560"></use></svg>
          <h2>Contact Us</h2>
          <p>
            Have questions or need personalized guidance? Reach out — we are here to help.
          </p>
          <form class="contact-form" action="#" method="post">
            <div class="form-group">
              <label for="contact-name">Name</label>
              <input type="text" id="contact-name" name="name" required>
            </div>
            <div class="form-group">
              <label for="contact-email">Email</label>
              <input type="email" id="contact-email" name="email" required>
            </div>
            <div class="form-group">
              <label for="contact-message">Message</label>
              <textarea id="contact-message" name="message" rows="4" required></textarea>
            </div>
            <button type="submit">Send Message</button>
          </form>
        </div>
      </section>

      <!-- LOGIN SECTION -->
      <section id="login" class="section">
        <div class="glass">
          <h2>Login</h2>
          <form class="login-form" action="/login" method="post">
            <div class="form-group">
              <label for="login-email">Email</label>
              <input type="email" id="login-email" name="email" required>
            </div>
            <div class="form-group">
              <label for="login-password">Password</label>
              <input type="password" id="login-password" name="password" required>
            </div>
            <button type="submit">Login</button>
            <div class="form-footer">
              Don&apos;t have an account? <a href="/signup">Sign Up</a>
            </div>
          </form>
        </div>
      </section>
    </div>
  </div>

  <script>

    // The camera fills the viewport: scroll into the landmark tower and reveal its student floors.
    const cameraCity = document.getElementById('camera-city');
    const cameraInterior = document.getElementById('camera-interior');
    const introScene = document.getElementById('intro');
    const storyFloors = [
      { section: document.getElementById('founder'), floor: document.getElementById('student-floor-1') },
      { section: document.getElementById('features'), floor: document.getElementById('student-floor-2') },
      { section: document.getElementById('contact'), floor: document.getElementById('student-floor-3') }
    ];
    let cameraTicking = false;
    function updateBuildingCamera() {
      if (!cameraCity || !cameraInterior || !introScene) return;
      const progress = Math.max(0, Math.min(1, -introScene.getBoundingClientRect().top / Math.max(1, window.innerHeight * .88)));
      const scale = 1 + progress * 2.05;
      const targetX = 850;
      const targetY = 430;
      cameraCity.setAttribute('transform', `translate(${targetX * (1 - scale)} ${targetY * (1 - scale)}) scale(${scale})`);
      cameraCity.style.opacity = String(1 - progress);
      let activeFloor = -1;
      const viewportMark = window.innerHeight * .54;
      storyFloors.forEach((item, index) => {
        if (item.section) { const rect = item.section.getBoundingClientRect(); if (rect.top <= viewportMark && rect.bottom > viewportMark) activeFloor = index; }
      });
      const interiorScale = .86 + progress * .14;
      cameraInterior.setAttribute('transform', `translate(${720 * (1 - interiorScale)} ${450 * (1 - interiorScale)}) scale(${interiorScale})`);
      cameraInterior.style.opacity = String(progress);
      storyFloors.forEach((item, index) => { if (item.floor) item.floor.style.opacity = activeFloor === -1 || activeFloor === index ? '1' : '.46'; });
      cameraTicking = false;
    }
    window.addEventListener('scroll', () => { if (!cameraTicking) { requestAnimationFrame(updateBuildingCamera); cameraTicking = true; } }, { passive: true });
    window.addEventListener('resize', updateBuildingCamera);
    updateBuildingCamera();

    // scroll‑driven triangle motion
    const triangle1 = document.getElementById('triangle1');
    const triangle2 = document.getElementById('triangle2');

    const initialRotation1 = 325.932;
    const initialRotation2 = 251.777;

    let ticking = false;

    function updateTriangles() {
      const scrollY = window.scrollY || window.pageYOffset;
      const windowHeight = window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;
      const maxScroll = documentHeight - windowHeight || 1;

      const scrollPercent = Math.min(1, Math.max(0, scrollY / maxScroll));

      const rotate1 = initialRotation1 + scrollPercent * 180;
      const translateX1 = scrollPercent * 80;
      const translateY1 = Math.sin(scrollPercent * Math.PI * 2) * 40;
      const scale1 = 1 + Math.sin(scrollPercent * Math.PI * 2) * 0.08;

      const rotate2 = initialRotation2 - scrollPercent * 180;
      const translateX2 = -scrollPercent * 80;
      const translateY2 = Math.cos(scrollPercent * Math.PI * 2) * 40;
      const scale2 = 1 + Math.cos(scrollPercent * Math.PI * 2) * 0.08;

      triangle1.style.transform = `
        translate(-40%, 40%)
        translate(${translateX1}px, ${translateY1}px)
        rotate(${rotate1}deg)
        scale(${scale1})
      `;

      triangle2.style.transform = `
        translate(40%, -40%)
        translate(${translateX2}px, ${translateY2}px)
        rotate(${rotate2}deg)
        scale(${scale2})
      `;

      ticking = false;
    }

    function requestTick() {
      if (!ticking) {
        window.requestAnimationFrame(updateTriangles);
        ticking = true;
      }
    }

    window.addEventListener('scroll', requestTick);
    window.addEventListener('resize', updateTriangles);
    updateTriangles();
  </script>
  <footer class="campus-frame-footer"><span>CampusHelp · Your college journey, organized</span><span>Welcome · Profile · Workspace</span></footer>
</body>
</html>
